+// same way as GuildBuffManage::RecalcGuildBuff: the old tier's stats off, the new tier's on,
+// skipped when this player already has the current tier
+void ServerBuffManage::ApplyStatsTo( CUser* pUser )
+{
+	if( !IsValidObj( pUser ) )
+		return;
