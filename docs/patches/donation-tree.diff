+	// donation-tree: any other category takes its group's line; one outside
+	// Weapon Skins / Fashion / Premium gets a neutral line, not the weapon one.
+	if( s_aDsTreeLeaf.GetSize() > 0 )
+	{
+		const CString strGroup = DS_GroupOf( kw );
+		if( strGroup == _T( "Fashion" ) )
+			return _T( "A cosmetic outfit piece. Changes your look only - no stat effect." );
+		if( strGroup == _T( "Premium" ) )
+			return _T( "A premium account item." );
+		if( strGroup != _T( "Weapon Skins" ) )
+			return _T( "A Donation Shop item." );
+	}
 	return _T( "A cosmetic weapon skin. Changes your weapon's look only - no stat effect." );
 }
 
