+// donation-tree: the category order and each category's top group, read from
+// DonationShopTree.inc when the window opens (CWndDonationShop::OnInitialUpdate),
+// so a category added or renamed in the tree needs no rebuild. InterpriteScript
+// leaves m_lpParent unset, so the group is passed down while walking.
+static CStringArray s_aDsTreeLeaf;		// leaf keywords, file order
+static CStringArray s_aDsTreeGroup;		// the "All Items" child each leaf sits under
+
+static void DS_CollectTreeOrder( LPTREEELEM lp, const CString& strGroup )
+{
+	if( lp == NULL )
+		return;
+	if( lp->m_ptrArray.GetSize() == 0 )
+	{
+		s_aDsTreeLeaf.Add( lp->m_strKeyword );
+		s_aDsTreeGroup.Add( strGroup );
+		return;
+	}
+	for( int i = 0; i < lp->m_ptrArray.GetSize(); i++ )
+		DS_CollectTreeOrder( (LPTREEELEM)lp->m_ptrArray.GetAt( i ), strGroup );
+}
+
+static void DS_LoadTreeOrder( LPTREEELEM lpRoot )
+{
+	s_aDsTreeLeaf.RemoveAll();
+	s_aDsTreeGroup.RemoveAll();
+	if( lpRoot == NULL )
+		return;
+	for( int i = 0; i < lpRoot->m_ptrArray.GetSize(); i++ )
+	{
+		LPTREEELEM lp = (LPTREEELEM)lpRoot->m_ptrArray.GetAt( i );
+		DS_CollectTreeOrder( lp, CString( lp->m_strKeyword ) );
+	}
+}
+
+// The top group of a leaf ("Weapon Skins" for "Sword"); empty when not in the tree.
+static CString DS_GroupOf( const CString& kw )
+{
+	for( int i = 0; i < s_aDsTreeLeaf.GetSize(); i++ )
+		if( kw.CompareNoCase( s_aDsTreeLeaf.GetAt( i ) ) == 0 )
+			return s_aDsTreeGroup.GetAt( i );
+	return CString();
+}
+
 // Generated flavour line for the detail card - there is no description field in
 // the item data (verified: ItemProp has none, no loader parses one). Keyed off the
 // clicked tree keyword, which is the item's family (leaf) or its parent.
