 #ifdef __WORLDSERVER
 #include "DPDatabaseClient.h"
 extern CDPDatabaseClient g_dpDBClient;
 #endif // __WORLDSERVER
 
+// PVP Token prizes. The compiled numbers are the defaults, GuildSiegePrize.lua overrides them (ReadPrizes,
+// PvP events part B 2026-10-12). Per kill + per siege are paid by the WorldServer, the weekly ladders by the DatabaseServer.
+static int s_nTokensPerKill = 2;					// every Guild Siege kill, at once (eveschool.cpp CGuildCombat::GetPoint)
+static int s_nSiegePrize[3] = { 50, 14, 7 };		// 1st-3rd guild of each siege, every member who fought (GuildCombatResultRanking)
+// Weekly ladders, rank 1 first (FFA/TDM step 3b, 2026-10-11: the old Red Chip ladders / 5).
+static int s_nGuildPrize[5]  = { 600, 300, 180, 72, 48 };
+static int s_nClassPrize[10] = { 200, 100, 60, 40, 30, 24, 20, 14, 8, 4 };
+static int s_nClassPerClassPrize[10] = { 100, 50, 30, 20, 15, 12, 10, 7, 4, 2 };
+static int s_nMvpPrize[10]   = { 300, 150, 90, 60, 45, 36, 30, 21, 12, 6 };
+
+// the value on top of the Lua stack: a whole number nMin..32767 (a PVP Token stack) -> nValue, else FALSE
+static BOOL GSReadPrizeValue( lua_State* L, int nMin, int& nValue )
+{
+	if( !lua_isnumber( L, -1 ) )
+		return FALSE;
+	double d = lua_tonumber( L, -1 );
+	if( d < nMin || d > 32767.0 || d != (double)(int)d )
+		return FALSE;
+	nValue = (int)d;
+	return TRUE;
+}
+
+static void GSReadPrizeNumber( lua_State* L, const char* szName, int nMin, int& nValue )
+{
+	lua_getglobal( L, szName );
+	if( !lua_isnil( L, -1 ) && !GSReadPrizeValue( L, nMin, nValue ) )
+		Error( "GuildSiegePrize.lua %s is not a whole number %d-32767, %d is used", szName, nMin, nValue );
+	lua_pop( L, 1 );
+}
+
+// { a, b, c, ... } rank 1 first; a missing or bad entry keeps its number, extra entries are ignored
+static void GSReadPrizeList( lua_State* L, const char* szName, int* pnList, int nCount )
+{
+	lua_getglobal( L, szName );
+	if( lua_istable( L, -1 ) )
+	{
+		for( int i = 0; i < nCount; i++ )
+		{
+			lua_rawgeti( L, -1, i + 1 );
+			if( !lua_isnil( L, -1 ) && !GSReadPrizeValue( L, 1, pnList[i] ) )
+				Error( "GuildSiegePrize.lua %s[%d] is not a whole number 1-32767, %d is used", szName, i + 1, pnList[i] );
+			lua_pop( L, 1 );
+		}
+	}
+	else if( !lua_isnil( L, -1 ) )
+		Error( "GuildSiegePrize.lua %s is not a list { ... }, the compiled prizes are used", szName );
+	lua_pop( L, 1 );
+}
+
+void CGuildSiegePrize::ReadPrizes( CLuaBase& lua )
+{
+	lua_State* L = lua.GetLuaState();
+	GSReadPrizeNumber( L, "TokensPerKill", 0, s_nTokensPerKill );
+	GSReadPrizeList( L, "SiegePrize", s_nSiegePrize, 3 );
+	GSReadPrizeList( L, "GuildPrize", s_nGuildPrize, 5 );
+	GSReadPrizeList( L, "ClassPrize", s_nClassPrize, 10 );
+	GSReadPrizeList( L, "ClassPerClassPrize", s_nClassPerClassPrize, 10 );
+	GSReadPrizeList( L, "MvpPrize", s_nMvpPrize, 10 );
+}
+
+void CGuildSiegePrize::LoadPrizes()
+{
+	FILE* f = fopen( "GuildSiegePrize.lua", "r" );
+	if( f == NULL )
+		return;
+	fclose( f );
+	CLuaBase lua;
+	if( lua.RunScript( "GuildSiegePrize.lua" ) != 0 )
+	{
+		Error( "CGuildSiegePrize::LoadPrizes - GuildSiegePrize.lua Run Failed, the compiled prizes are used" );
+		return;
+	}
+	ReadPrizes( lua );
+}
+
+int CGuildSiegePrize::GetTokensPerKill()
+{
+	return s_nTokensPerKill;
+}
+
+int CGuildSiegePrize::GetSiegePrize( int nPlace )
+{
+	if( nPlace < 0 || nPlace >= 3 )
+		return 0;
+	return s_nSiegePrize[nPlace];
+}
