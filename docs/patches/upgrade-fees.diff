--- a/Source/Source/_Common/UpgradeFees.h
+++ b/Source/Source/_Common/UpgradeFees.h
@@ -0,0 +1,58 @@
+// UpgradeFees.h: the Penya fees of the upgrade windows, read from UpgradeFees.lua (resource editor patch upgrade-fees.diff).
+// The WorldServer charges them (Server/Resource/UpgradeFees.lua); Neuz shows them and checks the player's Penya before
+// sending (Client/UpgradeFees.lua). Keep both copies the same.
+// No file, a script error, or a missing / non-number / negative / too large value keeps the old compiled fee.
+#ifndef __UPGRADEFEES_H__
+#define __UPGRADEFEES_H__
+
+#include "LuaBase.h"
+
+class CUpgradeFees
+{
+public:
+	int		nAwakening;			// OnAwakening (DPSrvr.cpp), was 100000
+	int		nRemoveAttribute;	// OnRemoveAttribute (DPSrvr.cpp), was 100000
+	int		nPiercing;			// OnPiercingSize (ItemUpgrade.cpp) + WndPiercing, was 100000
+	int		nSafePiercing;		// SmeltSafetyPiercingSize (ItemUpgrade.cpp) + CWndSmeltSafety, was 100000
+	int		nRemovePiercing;	// OnPiercingRemove (ItemUpgrade.cpp), was 1000000
+
+	static CUpgradeFees* GetInstance( void )
+	{
+		static CUpgradeFees sUpgradeFees;
+		return &sUpgradeFees;
+	}
+
+private:
+	CUpgradeFees( void )
+	: nAwakening( 100000 ), nRemoveAttribute( 100000 ), nPiercing( 100000 ), nSafePiercing( 100000 ), nRemovePiercing( 1000000 )
+	{
+		FILE* f = fopen( "UpgradeFees.lua", "r" );
+		if( f == NULL )
+			return;
+		fclose( f );
+		CLuaBase lua;
+		if( lua.RunScript( "UpgradeFees.lua" ) != 0 )
+		{
+			Error( "CUpgradeFees - UpgradeFees.lua Run Failed, the old fees are used" );
+			return;
+		}
+		Read( lua, "nAwakeningPenya", nAwakening );
+		Read( lua, "nRemoveAttributePenya", nRemoveAttribute );
+		Read( lua, "nPiercingPenya", nPiercing );
+		Read( lua, "nSafePiercingPenya", nSafePiercing );
+		Read( lua, "nRemovePiercingPenya", nRemovePiercing );
+	}
+	static void Read( CLuaBase& lua, char* szName, int& nValue )
+	{
+		lua.GetGloabal( szName );
+		if( lua_isnumber( lua.GetLuaState(), -1 ) )
+		{
+			double d = lua.ToNumber( -1 );
+			if( d >= 0 && d <= 2147483647.0 )
+				nValue = static_cast<int>( d );
+		}
+		lua.Pop( 1 );
+	}
+};
+
+#endif // __UPGRADEFEES_H__
