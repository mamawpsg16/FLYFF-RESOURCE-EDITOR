--- a/Source/Source/_Common/UpgradeFees.h
+++ b/Source/Source/_Common/UpgradeFees.h
@@ -0,0 +1,134 @@
+// UpgradeFees.h: the Penya fees of the upgrade / remove actions, read from UpgradeFees.lua (resource editor patch upgrade-fees.diff).
+// The WorldServer charges them (Server/Resource/UpgradeFees.lua); Neuz shows the piercing price and checks the player's Penya in
+// the safe piercing window (Client/UpgradeFees.lua). Keep both copies the same.
+// No file, a script error, or a missing / non-number / negative / too large value keeps the default below
+// (the old compiled fee; 0 = free for the actions that had no fee).
+#ifndef __UPGRADEFEES_H__
+#define __UPGRADEFEES_H__
+
+#include "LuaBase.h"
+
+class CUpgradeFees
+{
+public:
+	int		nAwakening;	// OnAwakening (DPSrvr.cpp), was 100000
+	int		nRemoveAttribute;	// OnRemoveAttribute (DPSrvr.cpp), was 100000
+	int		nPiercing;	// OnPiercingSize (ItemUpgrade.cpp) + WndPiercing, was 100000
+	int		nSafePiercing;	// SmeltSafetyPiercingSize (ItemUpgrade.cpp) + CWndSmeltSafety, was 100000
+	int		nRemovePiercing;	// OnPiercingRemove (ItemUpgrade.cpp), was 1000000
+	int		nEnchantGeneral;	// EnchantGeneral: normal upgrade, was 0
+	int		nEnchantAttribute;	// EnchantAttribute: element upgrade, was 0
+	int		nEnchantAccessory;	// RefineAccessory, was 0
+	int		nEnchantCollector;	// RefineCollector, was 0
+	int		nSafeGeneral;	// SmeltSafetyGeneral: safe window, normal, was 0
+	int		nSafeAccessory;	// SmeltSafetyAccessory, was 0
+	int		nSafeUltimate;	// SmeltSafetyUltimate, was 0
+	int		nChangeAttribute;	// ChangeAttribute: change element, was 0
+	int		nPiercingCard;	// OnPiercing: put a card in, was 0
+	int		nUltimateMakeItem;	// CUltimateWeapon::MakeItem, was 0
+	int		nUltimateMakeGem;	// MakeGem, was 0
+	int		nUltimateToUnique;	// TransWeapon General -> Unique, was 0
+	int		nUltimateToUltimate;	// TransWeapon Unique -> Ultimate, was 0
+	int		nUltimateSetGem;	// SetGem, was 0
+	int		nUltimateRemoveGem;	// RemoveGem, was 0
+	int		nUltimateEnchant;	// EnchantWeapon: Ultimate +1..+10, was 0
+	int		nBlessingCancel;	// OnBlessednessCancel, was 0
+	int		nRemoveLevelDown;	// OnRemoveItemLevelDown, was 0
+	int		nFastAwakeRoll;	// OnFastAwakeRoll: each roll, was 0
+	int		nPetAwakeningCancel;	// OnPickupPetAwakeningCancel, was 0
+	int		nRemoveVis;	// RemovePetVisItem (not when a vis expires), was 0
+	int		nSwapVis;	// SwapVis, was 0
+	int		nRemoveAura;	// OnRemoveAura, was 0
+	int		nLookChange;	// OnLookChange: transmute or revert, was 0
+
+	static CUpgradeFees* GetInstance( void )
+	{
+		static CUpgradeFees sUpgradeFees;
+		return &sUpgradeFees;
+	}
+
+#ifdef __WORLDSERVER
+	// one action's fee: 0 = free (no check); not enough Penya -> TID_GAME_LACKMONEY and FALSE (nothing taken); else taken
+	BOOL	CanPay( CUser* pUser, int nFee )
+	{
+		if( nFee <= 0 )
+			return TRUE;
+		if( pUser->GetGold() < nFee )
+		{
+			pUser->AddDefinedText( TID_GAME_LACKMONEY );
+			return FALSE;
+		}
+		return TRUE;
+	}
+	void	Pay( CUser* pUser, int nFee )
+	{
+		if( nFee > 0 )
+			pUser->AddGold( -nFee );
+	}
+	BOOL	Charge( CUser* pUser, int nFee )
+	{
+		if( !CanPay( pUser, nFee ) )
+			return FALSE;
+		Pay( pUser, nFee );
+		return TRUE;
+	}
+#endif // __WORLDSERVER
+
+private:
+	CUpgradeFees( void )
+	: nAwakening( 100000 ), nRemoveAttribute( 100000 ), nPiercing( 100000 ), nSafePiercing( 100000 ), nRemovePiercing( 1000000 ), nEnchantGeneral( 0 ), nEnchantAttribute( 0 ), nEnchantAccessory( 0 ), nEnchantCollector( 0 ), nSafeGeneral( 0 ), nSafeAccessory( 0 ), nSafeUltimate( 0 ), nChangeAttribute( 0 ), nPiercingCard( 0 ), nUltimateMakeItem( 0 ), nUltimateMakeGem( 0 ), nUltimateToUnique( 0 ), nUltimateToUltimate( 0 ), nUltimateSetGem( 0 ), nUltimateRemoveGem( 0 ), nUltimateEnchant( 0 ), nBlessingCancel( 0 ), nRemoveLevelDown( 0 ), nFastAwakeRoll( 0 ), nPetAwakeningCancel( 0 ), nRemoveVis( 0 ), nSwapVis( 0 ), nRemoveAura( 0 ), nLookChange( 0 )
+	{
+		FILE* f = fopen( "UpgradeFees.lua", "r" );
+		if( f == NULL )
+			return;
+		fclose( f );
+		CLuaBase lua;
+		if( lua.RunScript( "UpgradeFees.lua" ) != 0 )
+		{
+			Error( "CUpgradeFees - UpgradeFees.lua Run Failed, the old fees are used" );
+			return;
+		}
+		Read( lua, "nAwakeningPenya", nAwakening );
+		Read( lua, "nRemoveAttributePenya", nRemoveAttribute );
+		Read( lua, "nPiercingPenya", nPiercing );
+		Read( lua, "nSafePiercingPenya", nSafePiercing );
+		Read( lua, "nRemovePiercingPenya", nRemovePiercing );
+		Read( lua, "nEnchantGeneralPenya", nEnchantGeneral );
+		Read( lua, "nEnchantAttributePenya", nEnchantAttribute );
+		Read( lua, "nEnchantAccessoryPenya", nEnchantAccessory );
+		Read( lua, "nEnchantCollectorPenya", nEnchantCollector );
+		Read( lua, "nSafeGeneralPenya", nSafeGeneral );
+		Read( lua, "nSafeAccessoryPenya", nSafeAccessory );
+		Read( lua, "nSafeUltimatePenya", nSafeUltimate );
+		Read( lua, "nChangeAttributePenya", nChangeAttribute );
+		Read( lua, "nPiercingCardPenya", nPiercingCard );
+		Read( lua, "nUltimateMakeItemPenya", nUltimateMakeItem );
+		Read( lua, "nUltimateMakeGemPenya", nUltimateMakeGem );
+		Read( lua, "nUltimateToUniquePenya", nUltimateToUnique );
+		Read( lua, "nUltimateToUltimatePenya", nUltimateToUltimate );
+		Read( lua, "nUltimateSetGemPenya", nUltimateSetGem );
+		Read( lua, "nUltimateRemoveGemPenya", nUltimateRemoveGem );
+		Read( lua, "nUltimateEnchantPenya", nUltimateEnchant );
+		Read( lua, "nBlessingCancelPenya", nBlessingCancel );
+		Read( lua, "nRemoveLevelDownPenya", nRemoveLevelDown );
+		Read( lua, "nFastAwakeRollPenya", nFastAwakeRoll );
+		Read( lua, "nPetAwakeningCancelPenya", nPetAwakeningCancel );
+		Read( lua, "nRemoveVisPenya", nRemoveVis );
+		Read( lua, "nSwapVisPenya", nSwapVis );
+		Read( lua, "nRemoveAuraPenya", nRemoveAura );
+		Read( lua, "nLookChangePenya", nLookChange );
+	}
+	static void Read( CLuaBase& lua, char* szName, int& nValue )
+	{
+		lua.GetGloabal( szName );
+		if( lua_isnumber( lua.GetLuaState(), -1 ) )
+		{
+			double d = lua.ToNumber( -1 );
+			if( d >= 0 && d <= 2147483647.0 )
+				nValue = static_cast<int>( d );
+		}
+		lua.Pop( 1 );
+	}
+};
+
+#endif // __UPGRADEFEES_H__
